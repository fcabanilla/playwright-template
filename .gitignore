node_modules/
.allure/
!.allure/categories.json
dist/

# Environment variables (contienen credenciales sensibles)
.env
.env.local
.env.*.local

# MCP config with secrets (generated from .env via scripts/generate-mcp-config.cjs)
config/mcp/*.config.json

# MCP browser session artifacts (screenshots, snapshots)
.playwright-mcp/

# Session state files (contienen tokens y cookies sensibles)
loggedInState*.json
sessionState*.json
state/*.json

# Media files (generated by tests)
*.png
*.jpg
*.jpeg
*.gif
*.mp4
*.svg
*.webp
*.DS_Store

# Semaphore lock directories (test worker synchronization)
.locks/

# Generated testplan files (via scripts/generate-testplan.cjs)
testplan.json
testplan-*.json

# Allure report artifacts (legacy root-level directories)
allure-report/
allure-results/
