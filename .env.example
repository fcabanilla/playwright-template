# Environment Configuration for Multi-Cinema Testing Framework
# Copy this file to .env and modify values as needed

# ============================================
# General Configuration
# ============================================

# Test environment: production, staging, development
TEST_ENV=production

# User Agent suffix for request identification (optional)
# USER_AGENT_SUFFIX=ocgtest.es

# ============================================
# Cinesa Environment Overrides
# ============================================

# Override base URL for Cinesa (optional)
# CINESA_BASE_URL=https://www.cinesa.es

# Override API URL for Cinesa (optional)  
# CINESA_API_URL=https://api.cinesa.es

# Override timeouts for Cinesa tests (in milliseconds)
# CINESA_TIMEOUT_PAGE=30000
# CINESA_TIMEOUT_ELEMENT=10000
# CINESA_TIMEOUT_MODAL=15000

# Feature flags for Cinesa
# CINESA_FEATURE_ANALYTICS=true
# CINESA_FEATURE_MODALS=true
# CINESA_FEATURE_COOKIES=true

# ============================================
# UCI Environment Overrides
# ============================================

# Override base URL for UCI (optional)
# UCI_BASE_URL=https://www.ucicinemas.it

# Override API URL for UCI (optional)
# UCI_API_URL=https://api.ucicinemas.it

# Override timeouts for UCI tests (in milliseconds)
# UCI_TIMEOUT_PAGE=30000
# UCI_TIMEOUT_ELEMENT=10000
# UCI_TIMEOUT_MODAL=15000

# Feature flags for UCI
# UCI_FEATURE_ANALYTICS=true
# UCI_FEATURE_MODALS=true
# UCI_FEATURE_COOKIES=true

# ============================================
# Playwright Configuration
# ============================================

# Browser to use for testing (chromium, firefox, webkit)
# BROWSER=chromium

# Run tests in headed mode (true/false)
# HEADED=false

# Base URL for tests (can be overridden by namespace-specific URLs)
# BASE_URL=https://www.cinesa.es

# ============================================
# Test Accounts Configuration (Data-Driven Testing)
# ============================================

# ⚠️ SECURITY: Fill in REAL credentials and DO NOT commit .env file
# See docs/TEST_ACCOUNTS.md for setup instructions

# Valid Test Accounts
# --------------------

# No Membership Account (standard user)
TEST_NO_MEMBERSHIP_EMAIL=test.no.membership@cinesa-test.com
TEST_NO_MEMBERSHIP_PASSWORD=YourSecurePassword123!

# Loyalty Member Account (~500 points balance)
TEST_LOYALTY_EMAIL=test.loyalty@cinesa-test.com
TEST_LOYALTY_PASSWORD=YourSecurePassword123!

# Unlimited Member Account (standard tier, 2 friends)
TEST_UNLIMITED_EMAIL=test.unlimited@cinesa-test.com
TEST_UNLIMITED_PASSWORD=YourSecurePassword123!

# Unlimited Plus Member Account (premium tier, 5 friends)
TEST_UNLIMITED_PLUS_EMAIL=test.unlimited.plus@cinesa-test.com
TEST_UNLIMITED_PLUS_PASSWORD=YourSecurePassword123!

# Invalid Test Accounts
# ---------------------

# Default Identity for Signup/Login/Purchase Summary Tests
# -------------------------------------------------------
# Centralized test profile used by component data files
TEST_USER_FIRST_NAME=Federico
TEST_USER_LAST_NAME=Cabanilla
TEST_USER_EMAIL=federico.cabanilla@gmail.com
TEST_USER_USERNAME=federico.cabanilla
TEST_USER_PHONE=3517736362
TEST_USER_PASSWORD=Cinesa123!
TEST_USER_BIRTH_DATE=11/10/1990
TEST_USER_ID=35572069

# Valid Email with Wrong Password (for error testing)
TEST_VALID_EMAIL=test.valid@cinesa-test.com
TEST_WRONG_PASSWORD=IntentionallyWrongPassword123!

# Locked Account (for security testing)
TEST_LOCKED_EMAIL=test.locked@cinesa-test.com
TEST_LOCKED_PASSWORD=YourSecurePassword123!

# ============================================
# Cloudflare Access Configuration
# ============================================

# ⚠️ CRITICAL SECURITY: These credentials MUST be stored in a secret manager
# See: docs/adrs/0010-cloudflare-access-tokens.md for complete documentation

# Cloudflare Access is required for non-production environments (lab, preprod, staging)
# These tokens authenticate your automated tests with Cloudflare Access

# Naming Convention:
# - Per-environment (single token for all deployments): CF_ACCESS_CLIENT_ID_<ENV>
# - Per-deployment (when needed): CF_ACCESS_CLIENT_ID_<ENV>_<DEPLOYMENT>
# The code automatically tries specific keys first, then falls back to env-level keys

# Debug Mode (optional)
# Set to 'true' to see which Cloudflare Access variables are being looked up
# CF_ACCESS_DEBUG=false

# LAB Environment
# ---------------
# Required when TEST_ENV=lab
# Get these from Cloudflare Access dashboard or your security team
CF_ACCESS_CLIENT_ID_LAB=your-lab-client-id-here
CF_ACCESS_CLIENT_SECRET_LAB=your-lab-client-secret-here

# PREPROD Environment
# -------------------
# Required when TEST_ENV=preprod
CF_ACCESS_CLIENT_ID_PREPROD=your-preprod-client-id-here
CF_ACCESS_CLIENT_SECRET_PREPROD=your-preprod-client-secret-here

# STAGING Environment (if applicable)
# -----------------------------------
# Required when TEST_ENV=staging
# CF_ACCESS_CLIENT_ID_STAGING=your-staging-client-id-here
# CF_ACCESS_CLIENT_SECRET_STAGING=your-staging-client-secret-here

# Per-Deployment Overrides (Advanced)
# ------------------------------------
# Use these if different deployments (Cinesa ES, Cinesa PT, UCI, etc.) 
# within the same environment require different Cloudflare Access tokens

# Example: LAB environment with different tokens per deployment
# CF_ACCESS_CLIENT_ID_LAB_CINESA_ES=specific-token-for-cinesa-spain-lab
# CF_ACCESS_CLIENT_SECRET_LAB_CINESA_ES=specific-secret-for-cinesa-spain-lab

# CF_ACCESS_CLIENT_ID_LAB_CINESA_PT=specific-token-for-cinesa-portugal-lab
# CF_ACCESS_CLIENT_SECRET_LAB_CINESA_PT=specific-secret-for-cinesa-portugal-lab

# CF_ACCESS_CLIENT_ID_LAB_UCI=specific-token-for-uci-lab
# CF_ACCESS_CLIENT_SECRET_LAB_UCI=specific-secret-for-uci-lab

# Example: PREPROD environment with deployment-specific tokens
# CF_ACCESS_CLIENT_ID_PREPROD_CINESA_ES=specific-token-for-cinesa-spain-preprod
# CF_ACCESS_CLIENT_SECRET_PREPROD_CINESA_ES=specific-secret-for-cinesa-spain-preprod

# PRODUCTION Environment
# ----------------------
# ⚠️ IMPORTANT: Production typically does NOT require Cloudflare Access credentials
# If your production site requires CF Access (unusual), add them here:
# CF_ACCESS_CLIENT_ID_PRODUCTION=your-production-client-id-here
# CF_ACCESS_CLIENT_SECRET_PRODUCTION=your-production-client-secret-here

# How to Obtain Cloudflare Access Credentials:
# 1. Contact your DevOps/Security team
# 2. Access Cloudflare Teams dashboard: https://one.dash.cloudflare.com/
# 3. Navigate to: Access > Service Auth > Create Service Token
# 4. Copy Client ID and Client Secret
# 5. Store them securely in your secret manager (GitHub Secrets, Azure Key Vault, etc.)
# 6. For local development ONLY, add them to your .env file (NOT committed to git)

# Security Best Practices:
# - NEVER commit .env file with real credentials to git
# - Rotate credentials every 90 days minimum
# - Use different tokens per environment
# - If credentials are compromised, revoke immediately and rotate
# - In CI/CD, inject these from secret manager (GitHub Actions Secrets, etc.)

# Non-Existent Account (DO NOT create - must remain non-existent)
TEST_NON_EXISTENT_EMAIL=nonexistent.user@cinesa-test.com
TEST_NON_EXISTENT_PASSWORD=TestPassword123!

# Expired Unlimited Subscription (for renewal testing)
TEST_EXPIRED_UNLIMITED_EMAIL=test.expired.unlimited@cinesa-test.com
TEST_EXPIRED_UNLIMITED_PASSWORD=YourSecurePassword123!

# ============================================
# Example Usage
# ============================================

# To run tests against staging environment:
# TEST_ENV=staging npm run test:uci:navbar

# To run tests against custom URL:
# UCI_BASE_URL=https://my-local-server.com npm run test:uci:navbar

# To run tests with custom timeouts:
# UCI_TIMEOUT_PAGE=60000 UCI_TIMEOUT_MODAL=30000 npm run test:uci:navbar

# ============================================
# Cloudflare Access (CF-Access) - tokens (ADR-0010)
# ============================================
#
# These variables are used to authenticate the browser against Cloudflare Access
# protected environments (lab, preprod, staging). Do NOT commit real values.
# Store real secrets in your CI or secret manager and map them to these names.
# See docs/adrs/0010-cloudflare-access-tokens.md for the ADR and naming rules.
#
# Per-environment (preferred):
# Example: CF_ACCESS_CLIENT_ID_LAB, CF_ACCESS_CLIENT_SECRET_LAB
#
# CF_ACCESS_CLIENT_ID_<ENV>=
# CF_ACCESS_CLIENT_SECRET_<ENV>=
#
# Per-deployment overrides (optional). Replace <DEPLOYMENT> with e.g. CINESA_ES, CINESA_PT, UCI_IT:
# Example: CF_ACCESS_CLIENT_ID_LAB_CINESA_ES, CF_ACCESS_CLIENT_SECRET_PREPROD_CINESA_PT
#
# CF_ACCESS_CLIENT_ID_<ENV>_<DEPLOYMENT>=
# CF_ACCESS_CLIENT_SECRET_<ENV>_<DEPLOYMENT>=
#
# Real examples for Portugal preprod:
# CF_ACCESS_CLIENT_ID_PREPROD_PT=34ef53e32f12db8af9677fa964a73e0d.access
# CF_ACCESS_CLIENT_SECRET_PREPROD_PT=d1fb46e06e61d0bd8ce7d448578cc99cc0f88c962434ab32924d3dcfc93d8dc1
#
# Implementation notes:
# - Keep these variables out of VCS (.env is gitignored).
# - CI should map secret manager keys (e.g. secrets.CF_ACCESS_CLIENT_ID_LAB)
#   to these env vars when running tests against protected environments.
# - Code reads from process.env and falls back from <ENV>_<DEPLOYMENT> -> <ENV>.
# - On missing required variables, the test bootstrap will fail fast with a
#   clear message (no secret values logged).

# ============================================
# Azure Playwright Workspaces (Cloud Browsers)
# ============================================

# ⚠️ SECURITY: Store these in a secret manager (GitHub Secrets, Azure Key Vault, etc.)
# See: playwright.service.config.ts for configuration details

# Enable cloud browser testing (optional - for conditional logic)
# USE_PLAYWRIGHT_SERVICE=true

# Azure Playwright Workspace Endpoint
# Format: wss://<region>.api.playwright.microsoft.com/playwrightworkspaces/<workspace-id>/browsers
# Get this from Azure Portal > Playwright Workspace > "Add region endpoint in your setup"
# PLAYWRIGHT_SERVICE_URL=wss://westeurope.api.playwright.microsoft.com/playwrightworkspaces/9a9f6272-8172-4490-a5c6-156fc12ff7da/browsers

# Azure Playwright Access Token
# Get this from Azure Portal > Playwright Workspace > Access tokens
# Valid until the expiration date shown in Azure Portal
# Alternative: Use Microsoft Entra ID authentication (`az login`) - recommended for production
# PLAYWRIGHT_SERVICE_ACCESS_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudflare Bypass Secret Cookie (for Azure remote browsers)
# This cookie allows Playwright Service to bypass Cloudflare IP-based blocking
# Cloudflare blocks Azure datacenter IPs by default - this cookie acts as a bypass token
# Works for all domains: *.cinesa.es, *.ocgtest.es
# Contact DevOps team to get the secret value
# CLOUDFLARE_BYPASS_SECRET=your_secret_value_here

# How to Set Up Azure Playwright Workspaces:
# 1. Create workspace in Azure Portal: https://portal.azure.com/
#    - Search for "Playwright Workspaces"
#    - Create new workspace (requires Contributor/Owner role)
#    - Select region (e.g., West Europe)
# 2. Copy the WebSocket endpoint URL from workspace settings
# 3. Generate access token (or use Entra ID with `az login`)
# 4. Store credentials in secret manager
# 5. For local testing, add to .env file (NOT committed)

# Authentication Methods:
# - Access Token: Use PLAYWRIGHT_SERVICE_ACCESS_TOKEN (current setup)
# - Microsoft Entra ID: Use `az login` (recommended for production)
#   If using Entra ID, comment out PLAYWRIGHT_SERVICE_ACCESS_TOKEN

# Run Tests on Cloud Browsers:
# npm run test:cloud:smoke    # Quick smoke test on cloud
# npm run test:cloud:cinesa   # Full Cinesa suite on cloud (20 workers)
# npm run test:cloud:uci      # Full UCI suite on cloud (20 workers)
# npm run test:cloud:full     # All tests on cloud (30 workers)

# Migration Notice:
# Microsoft Playwright Testing is retiring March 8, 2026
# This configuration uses the new Azure Playwright Workspaces (GA)
# Package: @azure/playwright v1.0.0
# Docs: https://aka.ms/pww/docs


