{
  "name": "playwright-template",
  "version": "1.0.0",
  "description": "## Description",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.js",
    "test": "npx playwright test",
    "ui": "npx playwright test --ui",
    "report": "npm run report:copy-history && npm run report:generate && npm run report:open",
    "report:generate": "npx allure generate .allure/results --output .allure/report --clean",
    "report:copy-history": "mkdir -p .allure/results/history && (cp -r .allure/report/history/* .allure/results/history/ 2>/dev/null || true)",
    "report:open": "npx allure open .allure/report",
    "report:clean": "rm -rf .allure/results/* .allure/report/* .allure/playwright-artifacts/*",
    "report:clean:results": "rm -rf .allure/results/*",
    "report:watch": "npx allure watch .allure/results",
    "report:reset": "npm run report:clean && npm run report:generate && npm run report:open",
    "codegen": "npx playwright codegen https://www.cinesa.es",
    "codegen:uci": "npx playwright codegen https://www.ucicinemas.it",
    "codegen:cinesa:preprod": "cross-env TEST_ENV=preprod npx playwright codegen",
    "codegen:cinesa:lab": "cross-env TEST_ENV=lab npx playwright codegen",
    "codegen:cinesa:staging": "cross-env TEST_ENV=staging npx playwright codegen",
    "codegen:uci:preprod": "cross-env TEST_ENV=preprod npx playwright codegen",
    "codegen:uci:lab": "cross-env TEST_ENV=lab npx playwright codegen",
