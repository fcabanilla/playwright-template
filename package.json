{
  "name": "playwright-template",
  "version": "1.0.0",
  "description": "## Description",
  "type": "module",
  "scripts": {
    "_____DEVELOPMENT_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.js",
    "test": "npx playwright test",
    "ui": "npx playwright test --ui",
    "_____REPORTING_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "report": "npm run report:clean:blanks && npm run report:copy-categories && npm run report:copy-history && npm run report:generate && npm run report:open",
    "report:ci": "npm run report:clean:blanks && npm run report:copy-categories && npm run report:copy-history && npm run report:generate",
    "report:generate": "npx allure generate .allure/results --output .allure/report --clean",
    "report:copy-categories": "mkdir -p .allure/results && cp .allure/categories.json .allure/results/categories.json",
    "report:copy-history": "mkdir -p .allure/results/history && (cp -r .allure/report/history/* .allure/results/history/ 2>/dev/null || true)",
    "report:open": "npx allure open .allure/report",
    "report:clean": "rm -rf .allure/results/* .allure/report/* .allure/playwright-artifacts/*",
    "report:clean:results": "rm -rf .allure/results/*",
    "report:clean:blanks": "find .allure/playwright-artifacts -name 'test-failed-*.png' -size -15k -delete 2>/dev/null || true",
    "report:watch": "npx allure watch .allure/results",
    "watch-report": "npm run report:watch",
    "report:reset": "npm run report:clean && npm run report:generate && npm run report:open",
    "xray:export": "node scripts/generate-xray-import.js",
    "xray:export:open": "npm run xray:export && open xray-import.csv",
    "_____CLOUD_BROWSERS_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:cloud:smoke": "npx playwright test tests/cinesa/navbar/navbar.spec.ts --config=playwright.service.config.ts --project='Cinesa' --max-failures=1",
    "test:cloud:smoke:report": "npm run report:clean:results && npm run test:cloud:smoke && npm run report",
    "test:cloud:cinesa": "npx playwright test --config=playwright.service.config.ts --project='Cinesa' --workers=20",
    "test:cloud:uci": "npx playwright test --config=playwright.service.config.ts --project='UCI Cinemas' --workers=20",
    "test:cloud:full": "npx playwright test --config=playwright.service.config.ts --workers=30",
    "_____CODEGEN_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "codegen": "npx playwright codegen",
    "codegen:es": "npx playwright codegen https://www.cinesa.es",
    "codegen:es:preprod": "cross-env TEST_ENV=preprod npx playwright codegen",
    "codegen:es:lab": "cross-env TEST_ENV=lab npx playwright codegen",
    "codegen:pt": "npx playwright codegen https://www.ucicinemas.pt",
    "codegen:pt:preprod": "cross-env TEST_ENV=preprod-pt npx playwright codegen",
    "codegen:it": "npx playwright codegen https://www.ucicinemas.it",
    "_____CINESA_SPAIN_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:es": "npx playwright test --project='Cinesa'",
    "test:es:report": "npm run report:clean:results && npm run test:es && npm run report",
    "test:es:preprod": "cross-env TEST_ENV=preprod npm run test:es --",
    "test:es:lab": "cross-env TEST_ENV=lab npm run test:es --",
    "test:es:staging": "cross-env TEST_ENV=staging npm run test:es --",
    "test:es:regression": "npx playwright test --project='Cinesa' --grep-invert '@checkout' && npx playwright test --project='Cinesa' --grep '@checkout' --workers=1",
    "test:es:regression:lab": "cross-env TEST_ENV=lab npm run test:es:regression",
    "test:es:regression:preprod": "cross-env TEST_ENV=preprod npm run test:es:regression",
    "_____CINESA_PORTUGAL_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:pt": "cross-env TEST_ENV=production-pt npx playwright test --project='Cinesa'",
    "test:pt:preprod": "cross-env TEST_ENV=preprod-pt npm run test:pt:base --",
    "test:pt:lab": "cross-env TEST_ENV=lab-pt npm run test:pt:base --",
    "test:pt:base": "npx playwright test --project='Cinesa'",
    "_____UCI_ITALY_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:it": "npx playwright test --project='UCI Cinemas'",
    "test:it:report": "npm run report:clean:results && npm run test:it && npm run report",
    "test:it:preprod": "cross-env TEST_ENV=preprod npm run test:it --",
    "test:it:lab": "cross-env TEST_ENV=lab npm run test:it --",
    "test:it:staging": "cross-env TEST_ENV=staging npm run test:it --",
    "_____LEGACY_ALIASES_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:cinesa": "npm run test:es",
    "test:cinesa:preprod": "npm run test:es:preprod --",
    "test:cinesa:lab": "npm run test:es:lab --",
    "test:uci": "npm run test:it",
    "test:uci:preprod": "npm run test:it:preprod --",
    "test:uci:lab": "npm run test:it:lab --",
    "_____COMPONENT_TESTS_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:navbar": "npx playwright test tests/cinesa/navbar/navbar.spec.ts",
    "test:seatpicker": "npx playwright test tests/cinesa/seatPicker/seatPicker.spec.ts",
    "test:movies": "npx playwright test tests/cinesa/movies/movies.spec.ts",
    "test:cinemas": "npx playwright test tests/cinesa/cinemas/cinemas.spec.ts",
    "test:checkout:single-seat:lab": "cross-env TEST_ENV=lab npx playwright test tests/cinesa/checkout/checkout.smoke.spec.ts -g \"Single Seat · Credit Card — Oasiz\" --project='Cinesa' --workers=1 --no-deps",
    "test:checkout:single-seat:lab:report": "npm run report:clean:results && npm run test:checkout:single-seat:lab && npm run report",
    "test:footer": "npx playwright test tests/cinesa/footer/",
    "test:auth": "npx playwright test tests/cinesa/login tests/cinesa/signup --project=Cinesa",
    "test:auth:preprod": "cross-env TEST_ENV=preprod npm run test:auth --",
    "test:auth:lab": "cross-env TEST_ENV=lab npm run test:auth --",
    "_____PRAETOR_CHECKOUT_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:praetor": "npx playwright test --project='Praetor-Cinesa'",
    "test:praetor:lab": "cross-env TEST_ENV=lab npm run test:praetor --",
    "test:praetor:preprod": "cross-env TEST_ENV=preprod npm run test:praetor --",
    "test:praetor:checkout": "npx playwright test tests/praetor/cinesa/checkout/ --project='Praetor-Cinesa'",
    "test:praetor:checkout:lab": "cross-env TEST_ENV=lab npm run test:praetor:checkout --",
    "test:praetor:lab:report": "npm run report:clean:results && npm run test:praetor:lab && npm run report",
    "_____BROKEN_TESTS_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:broken": "npx playwright test --grep @broken-prod --project=Cinesa",
    "test:broken:preprod": "cross-env TEST_ENV=preprod npm run test:broken --",
    "test:broken:lab": "cross-env TEST_ENV=lab npm run test:broken --",
    "_____FAILED_TESTS_____": "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
    "test:failed": "npx playwright test --grep @failed-prod --project=Cinesa",
    "test:failed:preprod": "cross-env TEST_ENV=preprod npm run test:failed --",
    "test:failed:lab": "cross-env TEST_ENV=lab npm run test:failed --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fcabanilla/playwright-template.git"
  },
  "keywords": [],
  "author": "fcabanilla",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/fcabanilla/playwright-template/issues"
  },
  "homepage": "https://github.com/fcabanilla/playwright-template#readme",
  "devDependencies": {
    "@azure/identity": "^4.13.0",
    "@azure/playwright": "^1.0.0",
    "@playwright/cli": "^0.1.2",
    "@playwright/test": "^1.50.1",
    "@types/dotenv": "^6.1.1",
    "@types/node": "^22.13.8",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^2.15.1",
    "cross-env": "^10.1.0",
    "eslint": "9.21.0",
    "playwright": "^1.50.1",
    "playwright-core": "^1.50.1",
    "prettier": "3.5.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "imapflow": "^1.0.188"
  }
}
